NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_EXPIRES_IN=1d
FRONTEND_ORIGIN=http://localhost:3000
# Use lax locally. For separate HTTPS Vercel/Render origins, set none.
COOKIE_SAME_SITE=lax
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
